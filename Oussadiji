function projectSettings(){
modal("إعدادات المشروع",`
<form id="settingsForm">
<div class="field"><label>اسم المشروع</label><input id="setName" value="${esc(db.settings.name)}" required></div>
<div class="field"><label>العملة</label><input id="setCurrency" value="${esc(db.settings.currency)}"></div>
<div class="field full"><label>الوصف المختصر</label><input id="setSub" value="${esc(db.settings.subtitle)}"></div>
<div class="formActions"><button class="btn primary">💾 حفظ</button></div>
</form>`);
settingsForm.onsubmit=e=>{
e.preventDefault();
db.settings.name=setName.value.trim()||"مشروعي";db.settings.currency=setCurrency.value.trim()||"دج";db.settings.subtitle=setSub.value.trim();
save();closeModal();toast("تم تحديث معلومات المشروع");
};
}

function exportData(){
const payload={product:"Business Manager",version:1,exportedAt:new Date().toISOString(),data:db};
const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="بيانات-المشروع.json";a.click();URL.revokeObjectURL(a.href);toast("تم تصدير البيانات");
}

function importData(e){
const file=e.target.files[0];if(!file)return;
const r=new FileReader();
r.onload=()=>{
try{
const p=JSON.parse(r.result),x=p.data||p;
if(!x||!Array.isArray(x.sales)||!Array.isArray(x.expenses)||!Array.isArray(x.debts)||!Array.isArray(x.stock)||!Array.isArray(x.customers))throw 1;
db={...structuredClone(DEFAULT),...x,settings:{...DEFAULT.settings,...(x.settings||{})}};
save();closeModal();toast("تم استيراد البيانات بنجاح");
}catch(err){toast("ملف البيانات غير صالح")}
};
r.readAsText(file);
}

function resetData(){
if(!confirm("سيتم حذف جميع البيانات. هل أنت متأكد؟"))return;
if(!confirm("تأكيد أخير؟"))return;
db=structuredClone(DEFAULT);save();closeModal();toast("تم حذف البيانات");
}

/* UPDATE */
function renderAll(){
document.getElementById("brandName").textContent=db.settings.name;
document.getElementById("brandSub").textContent=db.settings.subtitle;
renderDashboard();renderSales();renderExpenses();renderDebts();renderStock();renderCustomers();renderReports();
}

renderAll();
</script>

