/* DASHBOARD */
function renderDashboard(){
const ts=db.sales.filter(x=>x.date===date()),te=db.expenses.filter(x=>x.date===date());
const tsum=ts.reduce((a,b)=>a+n(b.amount),0),tesum=te.reduce((a,b)=>a+n(b.amount),0);
const sales=db.sales.reduce((a,b)=>a+n(b.amount),0),exp=db.expenses.reduce((a,b)=>a+n(b.amount),0),debt=db.debts.reduce((a,b)=>a+n(b.amount),0);
todaySales.textContent=money(tsum);todayExp.textContent=money(tesum);netProfit.textContent=money(sales-exp);totalDebt.textContent=money(debt);
todaySalesCount.textContent=ts.length+" عملية";todayExpCount.textContent=te.length+" عملية";debtCount.textContent=db.debts.length+" دين";
stockCount.textContent=db.stock.length;customerCount.textContent=db.customers.length;salesCount.textContent=db.sales.length;

const all=[...db.sales.map(x=>({...x,type:"بيع",icon:"💰"})),...db.expenses.map(x=>({...x,type:"مصروف",icon:"💸"}))].sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,7);
recent.innerHTML=all.length?`<div class="activity">${all.map(x=>`<div class="activityItem"><div class="activityLeft"><div class="activityIcon">${x.icon}</div><div><div class="activityName">${esc(x.name)}</div><div class="activityDate">${x.type} • ${fmt(x.date)}</div></div></div><b>${money(x.amount)}</b></div>`).join("")}</div>`:`<div class="empty"><div>📋</div>لا توجد عمليات بعد.</div>`;

const low=db.stock.filter(x=>n(x.qty)<=n(x.min));
stockAlert.innerHTML=low.length?`<div class="activity">${low.slice(0,5).map(x=>`<div class="activityItem"><div class="activityLeft"><div class="activityIcon">⚠️</div><div><div class="activityName">${esc(x.name)}</div><div class="activityDate">الكمية الحالية: ${x.qty}</div></div></div><span class="badge badgeRed">منخفض</span></div>`).join("")}</div>`:`<div class="empty"><div>✓</div>المخزون في حالة جيدة.</div>`;
}

